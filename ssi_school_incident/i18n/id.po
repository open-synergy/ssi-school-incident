msgstr "Status"

#. module: ssi_school_incident
#: model:ir.model.fields,help:ssi_school_incident.field_school_academic_alert__activity_state
#: model:ir.model.fields,help:ssi_school_incident.field_school_academic_alert_level__activity_state
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident__activity_state
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident_escalation_criteria__activity_state
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident_type__activity_state
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident_weekly_review__activity_state
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"Status berdasarkan aktivitas\n"
"Terlambat: Tanggal jatuh tempo sudah lewat\n"
"Hari ini: Tanggal aktivitas adalah hari ini\n"
"Terencana: Aktivitas mendatang."

#. module: ssi_school_incident
#: model:ir.model.fields,field_description:ssi_school_incident.field_school_academic_alert__student_id
#: model:ir.model.fields,field_description:ssi_school_incident.field_school_incident__student_id
#: model_terms:ir.ui.view,arch_db:ssi_school_incident.school_academic_alert_view_search
