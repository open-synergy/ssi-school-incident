#. module: ssi_school_incident
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident_parent_contact__is_first_contact
msgid "True for the contact log entry with the earliest Contact Date & Time among all parent contact entries of the same incident; False for every other (later) entry."
msgstr "Benar untuk entri log kontak dengan Tanggal & Waktu Kontak paling awal di antara semua entri kontak orang tua pada insiden yang sama; Salah untuk setiap entri lainnya (yang lebih akhir)."

#. module: ssi_school_incident
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident__is_first_contact_overdue
msgid "True when no First Contact Date has been recorded yet and the current date/time is past the First Contact Deadline."
msgstr "Benar bila belum ada Tanggal Kontak Pertama yang tercatat dan tanggal/waktu saat ini telah melewati Batas Waktu Kontak Pertama."

#. module: ssi_school_incident
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident__is_resolution_overdue
msgid "True when the case has not reached a Resolved outcome yet and the current date/time is past the Resolution Deadline."
msgstr "Benar bila kasus belum mencapai hasil Terselesaikan dan tanggal/waktu saat ini telah melewati Batas Waktu Penyelesaian."

#. module: ssi_school_incident
#: model:ir.model.fields,help:ssi_school_incident.field_school_incident__is_overdue
msgid "True when this case is overdue on either its First Contact or its Resolution SLA. Stored so it can be used in list view decorations and in search filters/group-by."
msgstr "Benar bila kasus ini terlambat pada SLA Kontak Pertama atau SLA Penyelesaiannya. Disimpan agar dapat digunakan pada dekorasi tampilan daftar serta filter pencarian/pengelompokan."

